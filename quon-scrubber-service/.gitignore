# No trailing slash: a worktree may carry .venv as a symlink to another
# checkout's venv, and `.venv/` matches directories only, so the symlink would
# be committed as a file.
.venv
venv
__pycache__/
*.pyc
.pytest_cache/
.env
.env.production
.env.local
runtime_settings.json
quon.db
quon.db-wal
quon.db-shm

# Regenerable TLD / public-suffix cache (downloaded at runtime)
.tld_cache/
