# QUON scrubber service — configuration (all optional; defaults shown).
# Copy to .env and adjust as needed.

# --- Detection (all in-process; no provider is called to detect PII) --------
# GLiNER is the third detector. It ships OFF so a first `up` does not spend a
# minute pulling a 1.5 GB model — but the reference deployment runs it ON and
# every detection number in this repo is measured with it on. Turn it on.
GLINER_ENABLED=true

# --- Model provider: OpenRouter (server-side key; never sent to the browser) --
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Always run deterministic EMAIL/PHONE/IBAN recognizers alongside the LLM.
SAFETY_NET=true
# Also catch currency amounts deterministically (e.g. "145.000 €", "$4.2M").
# Note: this redacts ANY amount, including public figures like reported revenue.
SAFETY_NET_AMOUNTS=true

# Comma-separated CORS origins for the browser client. "*" allows any origin.
CORS_ALLOW_ORIGINS=*

# Logging level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Hard cap on input length (characters) sent to the model.
MAX_TEXT_LENGTH=50000

# ===========================================================================
# Multi-user auth, sessions, sync & key provisioning  (see SETUP.md)
# ===========================================================================

# SQLite file for accounts, sessions, E2E sync blobs and per-user keys.
# Relative paths anchor to the service dir; in Docker use the mounted volume.
DATABASE_PATH=quon.db

# Public URL of the frontend — used to build email verification/recovery links.
APP_BASE_URL=http://localhost:8080

# Session cookie. MUST be true in production (HTTPS); false for local http dev.
COOKIE_SECURE=true

# Server master secret — seals each user's OpenRouter sub-key at rest.
# MUST be set + kept STABLE in prod (rotating it invalidates sealed sub-keys).
# Generate with `openssl rand -base64 32` and paste the OUTPUT here (not the
# command — .env files are not evaluated by a shell).
QUON_SERVER_SECRET=

# --- OpenRouter provisioning (mints a $5 sub-key per verified user) ---------
# A *provisioning key* (Settings → Provisioning Keys in OpenRouter), separate
# from the inference key above. Empty → no provisioning (self-host BYOK).
OPENROUTER_PROVISIONING_KEY=
OPENROUTER_USER_LIMIT_USD=5
# Bearer token guarding the /admin/* key-lifecycle endpoints.
ADMIN_TOKEN=

# --- SMTP (email verification) ---------------------------------------------
# Empty SMTP_HOST → links are LOGGED instead of sent (dev). Any plain SMTP
# relay works for production; the provider must offer SMTP. Examples:
#
#  Cloudflare Email Service (implicit TLS, Workers Paid plan):
#    SMTP_HOST=smtp.mx.cloudflare.net
#    SMTP_PORT=465
#    SMTP_SSL=true
#    SMTP_USER=<email-sending-token-id>
#    SMTP_PASSWORD=<email-sending-token-secret>
#
#  Brevo (EU, free 300/day, STARTTLS):
#    SMTP_HOST=smtp-relay.brevo.com
#    SMTP_PORT=587
#    SMTP_USER=<brevo-login>
#    SMTP_PASSWORD=<brevo-smtp-key>
#
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=QUON <no-reply@quon.example.com>

# --- Beta feedback → GitHub issues (optional) --------------------------------
# Mirror each POST /feedback submission into an issue so it lands in a real
# backlog instead of only an inbox. Both must be set or the mirroring is off;
# the email is sent first and is unaffected either way.
# The token should be a FINE-GRAINED PAT limited to this one repository, with
# BOTH of these repository permissions — it is a write credential to a third
# party, so grant nothing beyond them:
#   - Issues:   Read and write   (filing the issue)
#   - Contents: Read and write   (committing the screenshot, see below)
# "Issues: write and nothing else" is NOT enough and fails in a way that is easy
# to miss: the issue is still created, while every screenshot upload 403s with
# "Resource not accessible by personal access token". Fine-grained PATs also
# expire by default — an expiry silently ends ALL feedback mirroring, so set a
# long one (or none) for an unattended server.
# The issue carries the message and the opaque user id, never the reporter's
# email address. The SCREENSHOT, if the user attached one, is committed to a
# dedicated `feedback-assets` branch in this repo and linked from the issue —
# that is what Contents is for. It never lands on `main`. Leave GITHUB_TOKEN
# empty to keep feedback email-only.
GITHUB_TOKEN=
GITHUB_REPO=owner/name
