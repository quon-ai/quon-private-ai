# QUON configuration - copy to .env and fill in.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Sections: [self-hosting] is read by the root docker-compose.yml;
# [frontend dev] is read by Vite for local development only.
# Full guide: docs/self-hosting.md

# ============================ [self-hosting] ================================

# Your public domain (Caddy obtains TLS automatically; DNS must point here).
QUON_DOMAIN=quon.example.com

# Required for production: seals per-user provider keys at rest. Generate with
#   openssl rand -base64 32
# Must stay STABLE once users exist - rotating it invalidates sealed keys.
QUON_SERVER_SECRET=

# OpenRouter API key for the chat relay (detection never leaves this box).
# Optional: without it, users must bring their own key (BYOK) in Settings.
OPENROUTER_API_KEY=

# Guards the /admin/* key-lifecycle endpoints. Generate like the server secret.
ADMIN_TOKEN=

# Closed-beta gate: when set, registration requires this code. Empty = open.
# On a public host, set this before the instance is reachable: with open
# registration the first account created becomes the admin, and every account
# bills its chat to the shared OPENROUTER_API_KEY above - set a limit on it.
SIGNUP_INVITE_CODE=

# Scrub-only demo at /demo: a visitor pastes a text and sees the placeholders,
# without an account. Off by default; nothing is stored and no model is called.
# Per-IP limit in ratelimit.py, plus a process-wide ceiling per minute.
DEMO_SCRUB_ENABLED=false
DEMO_SCRUB_MAX_CHARS=2000
DEMO_SCRUB_GLOBAL_PER_MINUTE=300
# Where the demo sends an interested visitor: a waiting-list page and a contact
# address, both optional. Empty = the page offers the sign-in instead.
DEMO_CONTACT_URL=
DEMO_CONTACT_EMAIL=

# E-mail verification: auto (default) = by mail when SMTP_HOST is set, otherwise
# accounts are active on creation - a home server needs no mail relay at all.
# required = always verify (without SMTP the link is only logged); off = never.
# Without verification AND without SIGNUP_INVITE_CODE, anyone who reaches the
# host can create an account - the backend logs that warning on every boot.
EMAIL_VERIFICATION=auto

# Only when the instance is behind Cloudflare (which sets CF-Connecting-IP
# itself). Anywhere else the rate limiter takes the address Caddy appended to
# X-Forwarded-For; a client-sent CF header would otherwise reset its bucket.
TRUST_CF_CONNECTING_IP=false

# SMTP for verification/reset mails - any plain SMTP relay. Leave SMTP_HOST
# empty on a private instance; with EMAIL_VERIFICATION=auto nothing is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=QUON <no-reply@quon.example.com>
# true (or port 465) = implicit TLS/SMTPS; otherwise STARTTLS on 587.
SMTP_SSL=false

# Third detector (in-process). Ships off; the reference deployment runs it on.
GLINER_ENABLED=true

# --- Optional knobs. Defaults match the code; see docs/self-hosting.md ------
# Allow a BYOK chat provider to target a private address (a LAN LLM, LM Studio).
# The SSRF guard blocks those unless this is true. Detection never leaves the box.
ALLOW_PRIVATE_PROVIDER_URLS=false
RATE_LIMIT_ENABLED=true
SESSION_TTL_HOURS=720
# Extra origins for the page CSP connect-src (e.g. a service in your own
# network the browser talks to directly). Frontend service.
QUON_CSP_CONNECT_EXTRA=

# ============================ [frontend dev] ================================
# Build-time Vite vars for `npm run dev` / manual builds. The Docker build
# bakes VITE_QUON_API_URL=/api (same-origin) - do not change it for compose.

# Base URL of the quon-scrubber-service backend (local dev).
VITE_QUON_API_URL=http://localhost:8000

# Master switch. When "false", text is sent without local scrubbing
# (the status indicator shows Offline and messages are flagged unprotected).
VITE_QUON_ENABLED=true

# Placeholder style sent to the scrubber: "typed" -> [PERSON], [EMAIL], ...
# "generic" -> every entity becomes [PII].
VITE_QUON_PLACEHOLDER_STYLE=typed

