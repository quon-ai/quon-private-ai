# QUON configuration — copy to .env and fill in.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Sections: [self-hosting] is read by the root docker-compose.yml;
# [frontend dev] is read by Vite for local development only.
# Full guide: docs/self-hosting.md

# ============================ [self-hosting] ================================

# Your public domain (Caddy obtains TLS automatically; DNS must point here).
QUON_DOMAIN=quon.example.com

# REQUIRED for production: seals per-user provider keys at rest. Generate with
#   openssl rand -base64 32
# Must stay STABLE once users exist — rotating it invalidates sealed keys.
QUON_SERVER_SECRET=

# OpenRouter API key for the shared cloud relay + cloud PII extraction.
# Optional: without it, users must bring their own key (BYOK) in Settings.
OPENROUTER_API_KEY=

# Optional: per-user OpenRouter sub-keys (spend-capped). Empty = BYOK mode.
OPENROUTER_PROVISIONING_KEY=
OPENROUTER_USER_LIMIT_USD=5

# Guards the /admin/* key-lifecycle endpoints. Generate like the server secret.
ADMIN_TOKEN=

# Closed-beta gate: when set, registration requires this code. Empty = OPEN.
# ⚠️ On a public host, set this BEFORE the instance is reachable: with open
# registration the FIRST account created becomes the admin, and every account
# bills chat + cloud PII to the shared OPENROUTER_API_KEY above, uncapped.
# (Alternative: set OPENROUTER_PROVISIONING_KEY for per-user capped sub-keys.)
SIGNUP_INVITE_CODE=

# SMTP for verification/reset emails. Empty SMTP_HOST = links are only written
# to the scrubber logs (fine for testing, unusable for real users).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=QUON <no-reply@quon.example.com>
# true (or port 465) = implicit TLS/SMTPS; otherwise STARTTLS on 587.
SMTP_SSL=false
# Beta-feedback inbox (POST /feedback). Empty = falls back to SMTP_FROM.
FEEDBACK_EMAIL=

# Third detector (in-process). Ships off; the reference deployment runs it on.
GLINER_ENABLED=true

# --- Optional knobs. Defaults match the code; see docs/self-hosting.md ------
# Allow a BYOK chat provider to target a PRIVATE address (a LAN LLM, LM Studio).
# The SSRF guard blocks those unless this is true. Detection never leaves the box.
ALLOW_PRIVATE_PROVIDER_URLS=false
# Send PII extraction to any OpenAI-compatible endpoint (empty = OpenRouter).
PII_CLOUD_BASE_URL=
PII_CLOUD_API_KEY=
RATE_LIMIT_ENABLED=true
SESSION_TTL_HOURS=720
# Agents call a paid LLM on a schedule — this is the cost bound (~daily).
AGENT_MIN_INTERVAL_SECONDS=72000
# Extra origins for the page CSP connect-src (e.g. a self-hosted Paperless the
# browser talks to directly). Frontend service.
QUON_CSP_CONNECT_EXTRA=

# ============================ [frontend dev] ================================
# Build-time Vite vars for `npm run dev` / manual builds. The Docker build
# bakes VITE_QUON_API_URL=/api (same-origin) — do not change it for compose.

# Base URL of the quon-scrubber-service backend (local dev).
VITE_QUON_API_URL=http://localhost:8000

# Master switch. When "false", text is sent without local scrubbing
# (the status indicator shows Offline and messages are flagged unprotected).
VITE_QUON_ENABLED=true

# Placeholder style sent to the scrubber: "typed" → [PERSON], [EMAIL], …
# "generic" → every entity becomes [PII].
VITE_QUON_PLACEHOLDER_STYLE=typed

# --- Dropbox connector (optional) -------------------------------------------
# Register ONE Dropbox app for this instance (scoped access; permissions
# files.metadata.read + files.content.read; redirect URI =
# https://<your domain>/connectors) and put its App key here. It is a public
# OAuth client id, not a secret. With this set, users get one-click
# "Connect Dropbox"; without it the connector is shown as not enabled.
DROPBOX_APP_KEY=
# Azure app registration (SPA, `common` tenant) for the OneDrive connector —
# a PUBLIC client id under PKCE. See docs/self-hosting.md.
MS_CLIENT_ID=

# --- Beta feedback → GitHub issues (optional) --------------------------------
# Mirror each POST /feedback submission into an issue so it lands in a real
# backlog instead of only an inbox. Both must be set or the mirroring is off;
# the email is sent first and is unaffected either way.
# The token should be a FINE-GRAINED PAT limited to this one repository with
# "Issues: write" and nothing else — it is a write credential to a third party.
# The issue carries the message and the opaque user id, never the reporter's
# email address, and never the screenshot (that stays in the email).
GITHUB_TOKEN=
GITHUB_REPO=owner/name
