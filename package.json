{
  "name": "quon",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "copy-ort": "node scripts/copy-ort.mjs",
    "predev": "node scripts/copy-ort.mjs && node scripts/write-version.mjs",
    "prebuild": "node scripts/copy-ort.mjs && node scripts/write-version.mjs",
    "prebuild:dev": "node scripts/copy-ort.mjs && node scripts/write-version.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:webkit": "playwright test --project=webkit",
    "e2e:headed": "playwright test --headed",
    "smoke:safari": "node scripts/safari-smoke.mjs",
    "ci:status": "node scripts/ci-status.mjs",
    "ci:cancel": "node scripts/ci-cancel.mjs",
    "licenses:notices": "npx --yes generate-license-file --input package.json --output THIRD_PARTY_NOTICES.txt --overwrite",
    "licenses:check": "npx --yes license-checker --production --excludePrivatePackages --failOn 'GPL-2.0;GPL-2.0-only;GPL-2.0-or-later;GPL-3.0;GPL-3.0-only;GPL-3.0-or-later;AGPL-3.0;AGPL-3.0-only;AGPL-3.0-or-later;SSPL-1.0'",
    "preflight": "npm run typecheck && npm run lint && npm run test && npm run build && node scripts/check-ssr-externals.mjs",
    "pree2e": "node scripts/fetch-e2e-models.mjs && node scripts/write-version.mjs",
    "write-version": "node scripts/write-version.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@huggingface/transformers": "^4.3.2",
    "@paddleocr/paddleocr-js": "0.4.2",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@scure/bip39": "^2.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "~1.168.60",
    "@tanstack/router-plugin": "^1.169.0",
    "@tauri-apps/plugin-http": "^2.8.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "0.8.3",
    "jspdf": "^4.2.1",
    "libsodium-wrappers-sumo": "^0.8.4",
    "lucide-react": "^0.575.0",
    "mammoth": "^1.13.0",
    "mermaid": "^12.3.0",
    "motion": "^12.43.0",
    "onnxruntime-web": "1.24.3",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "dompurify": "^3.4.11",
    "katex": "^0.18.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "description": "Privacy gateway for LLM chat: personal data is replaced with placeholders on your device before anything reaches the model provider. Zero-knowledge sync, self-hosted.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quon-ai/quon-private-ai.git"
  },
  "homepage": "https://github.com/quon-ai/quon-private-ai#readme",
  "bugs": {
    "url": "https://github.com/quon-ai/quon-private-ai/issues"
  }
}
