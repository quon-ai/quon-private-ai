{
  "name": "quon",
  "version": "0.10.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "copy-ort": "node scripts/copy-ort.mjs",
    "predev": "node scripts/copy-ort.mjs && node scripts/write-version.mjs",
    "prebuild": "node scripts/copy-ort.mjs && node scripts/write-version.mjs",
    "prebuild:dev": "node scripts/copy-ort.mjs && node scripts/write-version.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:webkit": "playwright test --project=webkit",
    "e2e:headed": "playwright test --headed",
    "smoke:safari": "node scripts/safari-smoke.mjs",
    "ci:status": "node scripts/ci-status.mjs",
    "ci:cancel": "node scripts/ci-cancel.mjs",
    "licenses:notices": "npx --yes generate-license-file --input package.json --output THIRD_PARTY_NOTICES.txt --overwrite",
    "licenses:check": "npx --yes license-checker --production --excludePrivatePackages --failOn 'GPL-2.0;GPL-2.0-only;GPL-2.0-or-later;GPL-3.0;GPL-3.0-only;GPL-3.0-or-later;AGPL-3.0;AGPL-3.0-only;AGPL-3.0-or-later;SSPL-1.0'",
    "preflight": "npm run typecheck && npm run lint && npm run test && npm run build",
    "pree2e": "node scripts/fetch-e2e-models.mjs && node scripts/write-version.mjs",
    "write-version": "node scripts/write-version.mjs"
  },
